# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/infra/cloudflare/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NotebookLM / Repomix packs (regenerate with npm run notebooklm:export*)
/notebooklm-dist/

# runtime artifacts (generated by the app — not source)
# Existing fixtures committed before this rule stay tracked; new files are ignored.
/runtime/cache/
/runtime/workspace/
/runtime/r2-sync-state.json
/runtime/jobs.json
/runtime/uploads/
/runtime/outputs/
/runtime/tmp/
# Audit manifests + dated state backups: operator working data, never source.
/runtime/archive/
/runtime/jobs.json.*
/runtime/r2-sync-state.json.*

# Build-time-generated auth hashes (emitted by scripts/emit-auth-hashes.cjs).
# Plaintext lives in .env / GitHub Secrets; the runtime .ts file is never
# committed. `npm run typecheck` stubs it first so fresh checkouts resolve.
/src/server/runtime/auth-passwords.generated.ts

# Claude Code personal scratch / per-checkout working memory
CLAUDE.local.md
.claude/ISSUES.local.md
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
runtime/jobs.json

# Forecast agent: job folders hold catalog media and must never be committed (public repo)
/agent/jobs/
/v1-agent-jobs/

# whisper.cpp binary, fetched/built by scripts/fetch-whisper.mjs
/resources/whisper/

# browser build output
/web/dist/
