# Required: OpenAI API key (Whisper transcription + GPT picker)
OPENAI_API_KEY=

# Optional: enables Gemini 2.5 Flash as the vision backend for the
# segment-and-describe pipeline. If unset, the pipeline falls back to
# GPT-4o-mini vision using OPENAI_API_KEY.
GEMINI_API_KEY=

# Optional overrides. Defaults below are correct for the Dockerfile.
# PORT=3000
# HOSTNAME=0.0.0.0
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
#
# Dev (`next dev`): catalog + videos default to ./runtime/workspace/ (not ../v1Drive).
# Production `next start` / Docker: default remains ../v1Drive/weather unless set.
# WEATHER_WORKSPACE_DIR=./runtime/workspace
#
# Optional Cloudflare R2 — DORMANT since v0.6.0 (fully local by default; the
# R2 tenant data was deleted 2026-08-12 after a verified local backup).
# If re-enabling: the runtime reads the username from R2_APP_USERNAME
# specifically (not EDITOR_USERNAME); Basic Auth = (R2_APP_USERNAME,
# EDITOR_PASSWORD) — no separate R2_APP_PASSWORD.
# R2_SYNC_ENABLED=1
# R2_GATEWAY_URL=https://weatherv1-r2-gateway.barprojectsandbuilds.workers.dev
# R2_TENANT_ID=default
# R2_BUCKET_NAME=weatherv1-media
#
# /api/plan defaults to the ver2 retrieve-then-pick pipeline since v0.4.0
# (planner emits desired_concepts, retrieval shortlists top-K=15 per scene
# with seeded tier-shuffle, single picker call, no editorial validator).
# Each job gets its own render_seed; pass `render_seed` in the /api/plan body
# to reproduce or remix. Set PLAN_PIPELINE_VER2=0 to fall back to the
# validator-based ver1 pipeline.
# PLAN_PIPELINE_VER2=0

# Required at build time: editor + admin gate passwords (plaintext) plus
# the canonical R2 Worker username. Hashed/baked into
# src/server/runtime/auth-passwords.generated.ts by the `prebuild` step
# (scripts/emit-auth-hashes.cjs). The build hard-fails if any is missing
# or empty — there is no fallback. In CI these come from GitHub Secrets;
# locally they live in your gitignored .env.
#
# EDITOR_USERNAME is the editor login username baked at build time;
# R2_APP_USERNAME is the accepted legacy fallback for that build step.
# NOTE: for the (dormant) R2 sync runtime, only R2_APP_USERNAME works —
# see the R2 block above.
EDITOR_PASSWORD=
ADMIN_PASSWORD=
EDITOR_USERNAME=v1editor
# R2_APP_USERNAME=v1editor
