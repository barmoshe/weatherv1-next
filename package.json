{
  "name": "weatherv1-next",
  "version": "0.7.1",
  "description": "WeatherV1 local desktop video production app",
  "author": "Barmoshe",
  "repository": {
    "type": "git",
    "url": "https://github.com/barmoshe/weatherv1-next.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "download-page:build": "node scripts/build-download-page.mjs",
    "download-page:dev": "node scripts/download-page-dev.mjs",
    "prebuild": "node --env-file-if-exists=.env scripts/emit-auth-hashes.cjs",
    "typecheck": "node scripts/ensure-auth-hashes-stub.cjs && tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "pretest": "node scripts/ensure-auth-hashes-stub.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "standalone:prep": "node scripts/prepare-standalone.cjs",
    "electron:dev": "node scripts/run-electron.cjs .",
    "electron:build": "npm run build && npm run standalone:prep && electron-forge package",
    "electron:make": "npm run build && npm run standalone:prep && electron-forge make",
    "notebooklm:export": "mkdir -p notebooklm-dist && repomix -o notebooklm-dist/weatherv1-full.md --style markdown",
    "notebooklm:export:chunks": "mkdir -p notebooklm-dist && repomix -c repomix.notebooklm-docs.json && repomix -c repomix.notebooklm-server.json && repomix -c repomix.notebooklm-app.json && repomix -c repomix.notebooklm-tooling.json",
    "notebooklm:export:chunks:txt": "mkdir -p notebooklm-dist && repomix -c repomix.notebooklm-docs.json -o notebooklm-dist/chunk-01-docs.txt --style plain && repomix -c repomix.notebooklm-server.json -o notebooklm-dist/chunk-02-src-server.txt --style plain && repomix -c repomix.notebooklm-app.json -o notebooklm-dist/chunk-03-src-app-client-tests.txt --style plain && repomix -c repomix.notebooklm-tooling.json -o notebooklm-dist/chunk-04-electron-scripts-infra.txt --style plain",
    "web:build": "vite build --config web/vite.config.ts",
    "web:package": "npm run web:build && node scripts/package-web.mjs",
    "web:e2e": "node web/test/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@huggingface/transformers": "4.3.1",
    "@mediabunny/aac-encoder": "1.62.1",
    "@tanstack/react-query": "^5",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "electron-squirrel-startup": "^1",
    "fflate": "0.8.2",
    "ffmpeg-static": "^5",
    "ffprobe-static": "^3",
    "formidable": "^3",
    "mediabunny": "1.62.1",
    "next": "16.2.6",
    "proper-lockfile": "^4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "update-electron-app": "^3",
    "uuid": "^9",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7",
    "@electron-forge/maker-squirrel": "^7",
    "@electron-forge/maker-zip": "^7",
    "@electron-forge/plugin-auto-unpack-natives": "^7",
    "@electron-forge/publisher-github": "^7",
    "@electron-forge/shared-types": "^7",
    "@pulumi/cloudflare": "^6.15.0",
    "@pulumi/pulumi": "^3.237.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/formidable": "^3",
    "@types/node": "^22",
    "@types/path-browserify": "1.0.3",
    "@types/proper-lockfile": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^2",
    "buffer": "6.0.3",
    "chokidar": "^4",
    "electron": "^33",
    "events": "3.3.0",
    "jsdom": "^25",
    "live-server": "^1.2.2",
    "memfs": "4.80.0",
    "path-browserify": "1.0.1",
    "playwright": "^1.56.1",
    "readable-stream": "4.7.0",
    "repomix": "^1.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^2"
  }
}
